# Copy to .env and fill in.
# Port 5050 not 5000: macOS AirPlay Receiver squats on 5000.
PORT=5050
DB_URL=mongodb://127.0.0.1:27017/autopay_shield
REDIS_URL=redis://localhost:6379
# Set to false to run without Redis (the cache fails open: requests read MongoDB directly).
REDIS_ENABLED=true
CRON_SCHEDULE=0 */6 * * *
# Optional. Only the AI explanation endpoint needs it; the API boots without it.
GROQ_API_KEY=
# Required for /api/admin routes (sent as the x-api-key header). If empty, admin routes are disabled.
ADMIN_API_KEY=
